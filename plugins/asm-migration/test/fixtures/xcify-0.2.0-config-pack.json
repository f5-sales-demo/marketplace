    {
      "kind": "ip_prefix_set",
      "metadata": {
        "name": "synthetic-policy-trusted-clients",
        "namespace": "example"
      },
      "spec": {
        "ipv4_prefixes": [
          {
            "ipv4_prefix": "192.0.2.10/32"
