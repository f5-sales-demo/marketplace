    {
      "kind": "service_policy",
      "metadata": {
        "name": "synthetic-policy-service-policy",
        "namespace": "example"
      },
      "spec": {
        "rule_list": {
          "rules": [
            {
              "metadata": {
                "name": "bypass-waf-for-trusted-clients"
              },
              "spec": {
                "action": "NEXT_POLICY",
                "any_asn": {},
                "any_client": {},
                "ip_matcher": {
                  "prefix_sets": [
                    {
                      "name": "synthetic-policy-trusted-clients",
                      "namespace": "example"
                    }
                  ]
                },
                "path": {
                  "prefix_values": [
                    "/"
                  ]
                },
                "waf_action": {
                  "waf_skip_processing": {}
                }
              }
            },
            {
              "metadata": {
                "name": "deny-url-private"
              },
              "spec": {
                "action": "DENY",
                "any_asn": {},
                "any_client": {},
                "any_ip": {},
                "path": {
                  "prefix_values": [
                    "/private"
                  ]
                }
              }
            },
            {
              "metadata": {
                "name": "disable-signatures-url-private"
              },
              "spec": {
                "action": "NEXT_POLICY",
                "any_asn": {},
                "any_client": {},
                "any_ip": {},
                "path": {
                  "prefix_values": [
                    "/private"
                  ]
                },
                "waf_action": {
                  "app_firewall_detection_control": {
                    "exclude_signature_contexts": [
                      {
                        "context": "CONTEXT_URL",
                        "signature_id": 0
                      }
                    ]
                  }
                }
              }
            },
            {
              "metadata": {
                "name": "deny-illegal-methods"
              },
              "spec": {
                "action": "DENY",
                "any_asn": {},
                "any_client": {},
                "any_ip": {},
                "http_method": {
                  "invert_matcher": true,
                  "methods": [
                    "GET",
                    "PATCH",
                    "POST"
                  ]
                },
                "path": {
                  "prefix_values": [
                    "/"
                  ]
                }
              }
            },
            {
              "metadata": {
                "name": "require-header-x-synthetic-token"
              },
              "spec": {
                "action": "DENY",
                "any_asn": {},
                "any_client": {},
                "any_ip": {},
                "headers": [
                  {
                    "check_not_present": {},
                    "name": "x-synthetic-token"
                  }
                ],
                "path": {
                  "prefix_values": [
                    "/"
                  ]
                }
              }
            },
            {
              "metadata": {
                "name": "parameter-range-quantity"
              },
              "spec": {
                "action": "DENY",
                "any_asn": {},
                "any_client": {},
                "any_ip": {},
                "path": {
                  "prefix_values": [
                    "/"
                  ]
                },
                "query_params": [
                  {
                    "item": {
                      "regex_values": [
                        "^(?!(?:1\\d|2[0-5])$).+"
                      ]
                    },
                    "key": "quantity"
                  }
                ]
              }
            },
            {
              "metadata": {
                "name": "parameter-maximum-length-quantity"
              },
              "spec": {
                "action": "DENY",
                "any_asn": {},
                "any_client": {},
                "any_ip": {},
                "path": {
                  "prefix_values": [
                    "/"
                  ]
                },
                "query_params": [
                  {
                    "item": {
                      "regex_values": [
                        "^.{3,}$"
                      ]
                    },
                    "key": "quantity"
                  }
                ]
              }
            },
            {
              "metadata": {
                "name": "deny-file-types"
              },
              "spec": {
                "action": "DENY",
                "any_asn": {},
                "any_client": {},
                "any_ip": {},
                "path": {
                  "suffix_values": [
                    ".bak",
                    ".exe"
                  ],
                  "transformers": [
                    "LOWER_CASE"
                  ]
                }
              }
            },
            {
              "metadata": {
                "name": "signature-exclusion-parameter-quantity"
              },
              "spec": {
                "action": "NEXT_POLICY",
                "any_asn": {},
                "any_client": {},
                "any_ip": {},
                "path": {
                  "prefix_values": [
                    "/"
                  ]
                },
                "waf_action": {
                  "app_firewall_detection_control": {
                    "exclude_signature_contexts": [
                      {
                        "context": "CONTEXT_PARAMETER",
                        "context_name": "quantity",
                        "signature_id": 200900001
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
  "schema_version": "asm-migration.config-pack/v1"
