#!/usr/bin/env python3
"""Exact-argv local/SSH Xorg computer control. Run --help for the command contract."""
import argparse, base64, json, os, pathlib, platform, subprocess, sys
sys.path.insert(0,str(pathlib.Path(__file__).resolve().parent))
from xorgctl_lib.common import VERSION, Fault, config, rpc, session_dir

def main():
    if len(sys.argv)>1 and sys.argv[1]=='_supervise':
        from xorgctl_lib.sessions import supervise
        supervise(sys.argv[2]); return
    if len(sys.argv)>1 and sys.argv[1]=='_service':
        from xorgctl_lib.sessions import service
        service(sys.argv[2]); return
    parser=argparse.ArgumentParser(description=__doc__,epilog='Examples: xorgctl --session lab session create; xorgctl --session lab screenshot --output screen.png; xorgctl input batch --params \'{"steps":[{"action":"click","x":100,"y":200}]}\'')
    parser.add_argument('--version',action='version',version=VERSION)
    parser.add_argument('--host',default=os.environ.get('XORGCTL_HOST','r.mordasiewicz@f5.com' if platform.system()=='Darwin' else 'local'))
    parser.add_argument('--session',default=os.environ.get('XORGCTL_SESSION','console'))
    parser.add_argument('--json',action='store_true')
    parser.add_argument('command',choices=['session','environment','screenshot','input','clipboard','window','app','display','inspect','browser','gpu','audio','record','control','view','artifact','capabilities'])
    parser.add_argument('action',nargs='?')
    parser.add_argument('--params',default='{}',help='JSON object of command arguments; see CLI reference')
    parser.add_argument('--input',help='local binary payload file, or - for stdin')
    parser.add_argument('--output',help='local binary artifact destination, or - for stdout')
    for key in ('geometry','display','auth','text','mime','selection','renderer','api','codec','url','profile','selector','service','username','target','kind','value','source','device','password-file','token'):
        parser.add_argument('--'+key)
    for key in ('window','x','y','width','height','workspace','pid','port','fps','seconds','stream','monitor'):
        parser.add_argument('--'+key,type=int)
    parser.add_argument('--immediate',action='store_true'); parser.add_argument('--no-cursor',action='store_true')
    a=parser.parse_args(); params=json.loads(a.params)
    if not isinstance(params,dict): raise Fault('--params must be a JSON object')
    for key in ('geometry','display','auth','text','mime','selection','renderer','api','codec','url','profile','selector','service','username','target','kind','value','source','device','password_file','token','window','x','y','width','height','workspace','pid','port','fps','seconds','stream','monitor'):
        if getattr(a,key) is not None: params[key]=getattr(a,key)
    if a.immediate: params['immediate']=True
    if a.no_cursor: params['cursor']=False
    payload=None
    if a.input: payload=sys.stdin.buffer.read() if a.input=='-' else pathlib.Path(a.input).read_bytes()
    if a.command=='clipboard' and a.action in ('mac-snapshot','mac-restore'):
        if platform.system()!='Darwin': raise Fault('Mac pasteboard commands must execute on macOS')
        from xorgctl_lib.mac_clipboard import helper
        result=helper('snapshot' if a.action=='mac-snapshot' else 'restore',payload)
        if a.output and a.output!='-': pathlib.Path(a.output).write_bytes(result); os.chmod(a.output,0o600)
        else: sys.stdout.buffer.write(result)
        return
    if a.command=='clipboard' and a.action=='sync':
        from xorgctl_lib.mac_clipboard import sync
        result=sync(pathlib.Path(__file__).resolve(),a.host,a.session,params.get('direction','to-linux'))
        print(json.dumps({'ok':True,'result':result})); return
    if a.host!='local':
        helper=pathlib.Path.home()/'.codex/skills/cross-host-cli/scripts/safe-ssh-exec'
        if not helper.is_file(): raise Fault('cross-host-cli must be installed for SSH transport')
        argv=[str(helper),'--host',a.host]
        if payload is not None: argv+=['--stdin']
        argv+=['--','/home/robin/.local/bin/xorgctl','--host','local','--session',a.session,'--json',a.command]
        if a.action: argv.append(a.action)
        argv+=['--params',json.dumps(params,ensure_ascii=False)]
        if payload is not None: argv+=['--input','-']
        if a.output: argv+=['--output','-']
        p=subprocess.run(argv,input=payload,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        sys.stderr.buffer.write(p.stderr)
        if p.returncode: sys.stdout.buffer.write(p.stdout); raise SystemExit(p.returncode)
        if a.output:
            if a.output=='-': sys.stdout.buffer.write(p.stdout)
            else:
                dst=pathlib.Path(a.output); dst.write_bytes(p.stdout); dst.chmod(0o600)
                print(json.dumps({'ok':True,'output':str(dst),'bytes':len(p.stdout)}))
        else: sys.stdout.buffer.write(p.stdout)
        return
    if a.command=='session':
        from xorgctl_lib.sessions import manage
        result=manage(a.session,a.action or 'status',params)
    elif a.command=='artifact':
        artifact=params.get('name',a.action)
        if not artifact or pathlib.Path(artifact).name!=artifact or artifact in ('.','..'): raise Fault('artifact requires a basename')
        path=session_dir(a.session)/'artifacts'/artifact
        data=path.read_bytes()
        if a.output and a.output!='-': pathlib.Path(a.output).write_bytes(data); os.chmod(a.output,0o600)
        else: sys.stdout.buffer.write(data)
        return
    elif a.command=='capabilities':
        result={'version':VERSION,'session':rpc(a.session,'status',{}),'contract':{'clipboard':'Qt PRIMARY and CLIPBOARD arbitrary multi-format bundles','input':'XTEST; keycodes/keysyms; animation; bounded held-input lease','screenshots':'Qt root image plus XFixes cursor','browser':'Chrome CDP semantic observation with estimated frame offsets','audio':'PulseAudio-compatible PipeWire API','accessibility':'bounded AT-SPI event observation and declarative application profiles','gpu':'must prove rendering per application; gpu probe alone is not visible rendering acceptance'},'limitations':['Xvfb RandR modes are server-limited; unsupported layout changes fail explicitly','Browser screen offsets require screenshot verification','Temporary paste completion uses a settling interval; target acceptance must be verified']}
    else:
        if payload is not None:
            if a.command=='input': params.update(json.loads(payload))
            else: params['data']=base64.b64encode(payload).decode()
        method=a.command if a.command=='screenshot' else a.command+'.'+(a.action or 'info')
        result=rpc(a.session,method,params)
    if a.output:
        if not isinstance(result,dict) or 'artifact' not in result: raise Fault('this command did not produce an artifact')
        data=(session_dir(a.session)/'artifacts'/result['artifact']).read_bytes()
        if a.output=='-': sys.stdout.buffer.write(data)
        else: pathlib.Path(a.output).write_bytes(data); os.chmod(a.output,0o600)
        print(json.dumps({'ok':True,'result':result}),file=sys.stderr)
    else: print(json.dumps({'ok':True,'result':result},ensure_ascii=False,indent=None if a.json else 2))

if __name__=='__main__':
    try: main()
    except (Fault,ValueError,KeyError,OSError,EOFError) as e:
        print(json.dumps({'ok':False,'error':str(e)}),file=sys.stderr); sys.exit(1)
    except KeyboardInterrupt:
        print(json.dumps({'ok':False,'error':'interrupted; disconnect cancels active operation'}),file=sys.stderr); sys.exit(130)
