{
  "version": 2,
  "sheets": [
    {
      "name": "MEDDPICC Deal Review",
      "kind": "grid",
      "columns": [
        {
          "min": 1,
          "max": 1,
          "width": 3.5
        },
        {
          "min": 2,
          "max": 2,
          "width": 18
        },
        {
          "min": 3,
          "max": 17,
          "width": 13.9
        }
      ],
      "blocks": [
        {
          "kind": "title",
          "text": "MEDDPICC Deal Review"
        },
        {
          "kind": "section",
          "text": "Deal"
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Account Name"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "accountName",
              "jsonPath": "metadata.accountName",
              "valueType": "string",
              "shadeWhenEmpty": true
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Deal ID"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "dealId",
              "jsonPath": "metadata.dealId",
              "valueType": "string",
              "shadeWhenEmpty": true
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Deal/Project Name"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "dealName",
              "jsonPath": "metadata.dealName",
              "valueType": "string",
              "shadeWhenEmpty": true
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Account Team"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "accountTeam",
              "jsonPath": "metadata.accountTeam",
              "valueType": "string"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Deal Status"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "dealStatus",
              "jsonPath": "metadata.dealStatus",
              "valueType": "string",
              "validate": true
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Forecast Stage"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "forecastStage",
              "jsonPath": "metadata.forecastStage",
              "valueType": "string",
              "validate": true
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Close Date"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "closeDate",
              "jsonPath": "metadata.closeDate",
              "valueType": "date"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Win Probability"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "winProbability",
              "jsonPath": "metadata.winProbability",
              "valueType": "percent"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Reviewer"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "reviewer",
              "jsonPath": "metadata.reviewer",
              "valueType": "string"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Review Date"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "reviewDate",
              "jsonPath": "metadata.reviewDate",
              "valueType": "date"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Competition"
            },
            {
              "kind": "field",
              "span": 14,
              "id": "competition",
              "jsonPath": "metadata.competition",
              "valueType": "text"
            }
          ]
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Revenue"
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Subscription"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "revenueSubscription",
              "jsonPath": "metadata.revenue.subscription",
              "valueType": "currency"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Hardware"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "revenueHardware",
              "jsonPath": "metadata.revenue.hardware",
              "valueType": "currency"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Software"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "revenueSoftware",
              "jsonPath": "metadata.revenue.software",
              "valueType": "currency"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "ACV"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "acv",
              "jsonPath": "metadata.revenue.acv",
              "valueType": "currency"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Total Booked Value"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "revenueTotal",
              "formula": "{{ref:revenueSubscription}}+{{ref:revenueHardware}}+{{ref:revenueSoftware}}",
              "valueType": "currency"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Factored Pipeline"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "factoredPipeline",
              "formula": "{{ref:acv}}*{{ref:winProbability}}",
              "valueType": "currency"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Days To Close"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "daysToClose",
              "formula": "IF({{ref:closeDate}}=\"\",\"\",{{ref:closeDate}}-TODAY())",
              "valueType": "number"
            },
            {
              "kind": "blank",
              "span": 4
            }
          ]
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Client Interaction"
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Last Interaction"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "lastInteractionDate",
              "jsonPath": "metadata.lastClientInteraction.date",
              "valueType": "date"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Next Interaction"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "nextInteractionDate",
              "jsonPath": "metadata.nextClientInteraction.date",
              "valueType": "date"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Days Since Last"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "daysSinceLastInteraction",
              "formula": "IF({{ref:lastInteractionDate}}=\"\",\"\",TODAY()-{{ref:lastInteractionDate}})",
              "valueType": "number"
            },
            {
              "kind": "blank",
              "span": 4
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Outcome"
            },
            {
              "kind": "field",
              "span": 14,
              "id": "lastInteractionOutcome",
              "jsonPath": "metadata.lastClientInteraction.outcome",
              "valueType": "text"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Objective"
            },
            {
              "kind": "field",
              "span": 14,
              "id": "nextInteractionObjective",
              "jsonPath": "metadata.nextClientInteraction.objective",
              "valueType": "text"
            }
          ]
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Qualification"
        },
        {
          "kind": "table",
          "table": {
            "id": "elements",
            "source": {
              "kind": "elements"
            },
            "anchorColumn": 2,
            "keyColumn": "element",
            "columns": [
              {
                "id": "element",
                "header": "Element",
                "role": "derived",
                "valueType": "string",
                "span": 2,
                "note": "elementDefinition",
                "heading": true
              },
              {
                "id": "score",
                "header": "Score",
                "role": "input",
                "jsonPath": "qualification.*.score",
                "valueType": "score",
                "conditionalFormat": "score",
                "validate": true,
                "span": 1
              },
              {
                "id": "rubric",
                "header": "What This Score Means",
                "role": "derived",
                "valueType": "text",
                "span": 3,
                "followsInput": true
              },
              {
                "id": "evidence",
                "header": "Evidence",
                "role": "input",
                "jsonPath": "qualification.*.evidence",
                "valueType": "text",
                "shadeWhenEmpty": true,
                "span": 4
              },
              {
                "id": "notes",
                "header": "Notes",
                "role": "input",
                "jsonPath": "qualification.*.notes",
                "valueType": "text",
                "span": 6
              }
            ]
          }
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "table",
          "table": {
            "id": "responses",
            "source": {
              "kind": "elementResponses"
            },
            "anchorColumn": 2,
            "columns": [
              {
                "id": "element",
                "header": "Element",
                "role": "derived",
                "valueType": "string",
                "span": 2,
                "groupRuns": true,
                "heading": true
              },
              {
                "id": "question",
                "header": "Question",
                "role": "derived",
                "valueType": "text",
                "span": 5
              },
              {
                "id": "response",
                "header": "Response",
                "role": "input",
                "jsonPath": "qualification.*.responses[]",
                "valueType": "text",
                "shadeWhenEmpty": true,
                "span": 9
              }
            ]
          }
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "3 Whys \u2014 (Why Anything, Why Us, Why Now)"
        },
        {
          "kind": "group",
          "cells": [
            {
              "span": 8,
              "text": "Us"
            },
            {
              "span": 8,
              "text": "Partner"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Why Anything"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "whyAnything",
              "jsonPath": "threeWhys.us.whyAnything",
              "valueType": "text",
              "shadeWhenEmpty": true
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Why Anything"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "partnerWhyAnything",
              "jsonPath": "threeWhys.partner.whyAnything",
              "valueType": "text"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Why Us"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "whyUs",
              "jsonPath": "threeWhys.us.whyUs",
              "valueType": "text",
              "shadeWhenEmpty": true
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Why This Partner"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "partnerWhyThisPartner",
              "jsonPath": "threeWhys.partner.whyThisPartner",
              "valueType": "text"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Why Now"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "whyNow",
              "jsonPath": "threeWhys.us.whyNow",
              "valueType": "text",
              "shadeWhenEmpty": true
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Why Now"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "partnerWhyNow",
              "jsonPath": "threeWhys.partner.whyNow",
              "valueType": "text"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "blank",
              "span": 8
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Partner Name"
            },
            {
              "kind": "field",
              "span": 6,
              "id": "partnerName",
              "jsonPath": "threeWhys.partner.name",
              "valueType": "string"
            }
          ]
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Stakeholder Analysis"
        },
        {
          "kind": "table",
          "table": {
            "id": "stakeholders",
            "source": {
              "kind": "list",
              "jsonPath": "stakeholders"
            },
            "anchorColumn": 2,
            "minRows": 10,
            "columns": [
              {
                "id": "name",
                "header": "Name",
                "role": "input",
                "jsonPath": "name",
                "valueType": "string",
                "shadeWhenEmpty": true,
                "span": 2
              },
              {
                "id": "title",
                "header": "Title",
                "role": "input",
                "jsonPath": "title",
                "valueType": "string",
                "shadeWhenEmpty": true,
                "span": 3
              },
              {
                "id": "roleInDeal",
                "header": "Role In Deal",
                "role": "input",
                "jsonPath": "roleInDeal",
                "valueType": "string",
                "shadeWhenEmpty": true,
                "validate": true,
                "span": 2
              },
              {
                "id": "mustSayYes",
                "header": "Must Say Yes?",
                "role": "input",
                "jsonPath": "mustSayYes",
                "valueType": "boolean",
                "span": 1,
                "validate": true
              },
              {
                "id": "canSayNo",
                "header": "Can Say No?",
                "role": "input",
                "jsonPath": "canSayNo",
                "valueType": "boolean",
                "span": 1,
                "validate": true
              },
              {
                "id": "whatTheyNeedToBelieve",
                "header": "What Do They Need To Believe To Say Yes To The Deal?",
                "role": "input",
                "jsonPath": "whatTheyNeedToBelieve",
                "valueType": "text",
                "span": 4
              },
              {
                "id": "sentiment",
                "header": "Sentiment",
                "role": "input",
                "jsonPath": "sentiment",
                "valueType": "string",
                "validate": true,
                "span": 1
              },
              {
                "id": "relationshipOwner",
                "header": "Relationship Owner",
                "role": "input",
                "jsonPath": "relationshipOwner",
                "valueType": "string",
                "span": 2
              }
            ]
          }
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Sales Strategy"
        },
        {
          "kind": "group",
          "cells": [
            {
              "span": 8,
              "text": "What Is Our Differentiated Value Proposition"
            },
            {
              "span": 8,
              "text": "What Is Our Sales/Win Strategy?"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "field",
              "span": 8,
              "id": "differentiatedValueProposition",
              "jsonPath": "salesStrategy.differentiatedValueProposition",
              "valueType": "text",
              "shadeWhenEmpty": true
            },
            {
              "kind": "field",
              "span": 8,
              "id": "winStrategy",
              "jsonPath": "salesStrategy.winStrategy",
              "valueType": "text",
              "shadeWhenEmpty": true
            }
          ]
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Close Plan"
        },
        {
          "kind": "group",
          "cells": [
            {
              "span": 8,
              "text": "High Level Milestones Agreed With Customer"
            },
            {
              "span": 8,
              "text": "Critical Actions & Next Steps To Support Close Plan"
            }
          ]
        },
        {
          "kind": "table",
          "table": {
            "id": "milestones",
            "source": {
              "kind": "list",
              "jsonPath": "closePlan.milestones"
            },
            "anchorColumn": 2,
            "minRows": 8,
            "columns": [
              {
                "id": "description",
                "header": "Milestone",
                "role": "input",
                "jsonPath": "description",
                "valueType": "text",
                "span": 4
              },
              {
                "id": "targetDate",
                "header": "Target Date",
                "role": "input",
                "jsonPath": "targetDate",
                "valueType": "date",
                "conditionalFormat": "overdueDate",
                "span": 2
              },
              {
                "id": "status",
                "header": "Status",
                "role": "input",
                "jsonPath": "status",
                "valueType": "string",
                "conditionalFormat": "statusText",
                "validate": true,
                "span": 2
              }
            ]
          }
        },
        {
          "kind": "table",
          "table": {
            "id": "actions",
            "source": {
              "kind": "list",
              "jsonPath": "closePlan.criticalActions"
            },
            "anchorColumn": 10,
            "minRows": 8,
            "columns": [
              {
                "id": "action",
                "header": "Critical Action",
                "role": "input",
                "jsonPath": "action",
                "valueType": "text",
                "span": 4
              },
              {
                "id": "owner",
                "header": "Owner",
                "role": "input",
                "jsonPath": "owner",
                "valueType": "string",
                "span": 2
              },
              {
                "id": "dueDate",
                "header": "Due Date",
                "role": "input",
                "jsonPath": "dueDate",
                "valueType": "date",
                "conditionalFormat": "overdueDate",
                "span": 1
              },
              {
                "id": "status",
                "header": "Status",
                "role": "input",
                "jsonPath": "status",
                "valueType": "string",
                "conditionalFormat": "statusText",
                "validate": true,
                "span": 1
              }
            ]
          }
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Team"
        },
        {
          "kind": "group",
          "cells": [
            {
              "span": 8,
              "text": "Internal Team"
            },
            {
              "span": 8,
              "text": "Partner Team"
            }
          ]
        },
        {
          "kind": "table",
          "table": {
            "id": "teamInternal",
            "source": {
              "kind": "list",
              "jsonPath": "team.internal"
            },
            "anchorColumn": 2,
            "minRows": 8,
            "columns": [
              {
                "id": "name",
                "header": "Name",
                "role": "input",
                "jsonPath": "name",
                "valueType": "string",
                "span": 3
              },
              {
                "id": "role",
                "header": "Role",
                "role": "input",
                "jsonPath": "role",
                "valueType": "string",
                "span": 3
              },
              {
                "id": "dateRequiredFrom",
                "header": "Date Required From",
                "role": "input",
                "jsonPath": "dateRequiredFrom",
                "valueType": "date",
                "span": 1
              },
              {
                "id": "assignedToDeal",
                "header": "Assigned To Deal?",
                "role": "input",
                "jsonPath": "assignedToDeal",
                "valueType": "boolean",
                "span": 1,
                "validate": true
              }
            ]
          }
        },
        {
          "kind": "table",
          "table": {
            "id": "teamPartner",
            "source": {
              "kind": "list",
              "jsonPath": "team.partner"
            },
            "anchorColumn": 10,
            "minRows": 6,
            "columns": [
              {
                "id": "name",
                "header": "Name",
                "role": "input",
                "jsonPath": "name",
                "valueType": "string",
                "span": 3
              },
              {
                "id": "role",
                "header": "Role",
                "role": "input",
                "jsonPath": "role",
                "valueType": "string",
                "span": 3
              },
              {
                "id": "dateRequiredFrom",
                "header": "Date Required From",
                "role": "input",
                "jsonPath": "dateRequiredFrom",
                "valueType": "date",
                "span": 1
              },
              {
                "id": "assignedToDeal",
                "header": "Assigned To Deal?",
                "role": "input",
                "jsonPath": "assignedToDeal",
                "valueType": "boolean",
                "span": 1,
                "validate": true
              }
            ]
          }
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Scorecard"
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Total Score"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "scoreTotal",
              "formula": "SUM({{col:elements.score}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Maximum"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "scoreMaximum",
              "formula": "COUNTA({{col:elements.element}})*4",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Overall"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "scorePercent",
              "formula": "IF({{ref:scoreMaximum}}=0,0,{{ref:scoreTotal}}/{{ref:scoreMaximum}})",
              "valueType": "percent"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Rating"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "scoreRating",
              "formula": "IF({{ref:scoreTotal}}>=26,\"Green\",IF({{ref:scoreTotal}}>=14,\"Yellow\",\"Red\"))",
              "valueType": "rating",
              "conditionalFormat": "ragText"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Previous Total"
            },
            {
              "kind": "derived",
              "span": 2,
              "id": "scorePreviousTotal",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Change"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "scoreChange",
              "formula": "{{ref:scoreTotal}}-{{ref:scorePreviousTotal}}",
              "valueType": "number",
              "conditionalFormat": "delta"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Elements At Zero"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "elementsAtZero",
              "formula": "COUNTIF({{col:elements.score}},0)",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Below Three"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "elementsBelowThree",
              "formula": "COUNTIF({{col:elements.score}},\"<3\")",
              "valueType": "number"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Weakest Element"
            },
            {
              "kind": "computed",
              "span": 6,
              "id": "lowestElement",
              "formula": "INDEX({{col:elements.element}},MATCH(MIN({{col:elements.score}}),{{col:elements.score}},0))",
              "valueType": "string"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Economic Buyer"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "economicBuyerScore",
              "formula": "{{row:elements.score@economicBuyer}}",
              "valueType": "score"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Champion"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "championScore",
              "formula": "{{row:elements.score@champion}}",
              "valueType": "score"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Sections Complete"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "sectionsComplete",
              "formula": "COUNTIF({{col:sections.status}},{{word:statusComplete}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Sections Tracked"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "sectionsTracked",
              "formula": "COUNTA({{col:sections.section}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Completion"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "completionPercent",
              "formula": "IF({{ref:sectionsTracked}}=0,0,{{ref:sectionsComplete}}/{{ref:sectionsTracked}})",
              "valueType": "percent"
            },
            {
              "kind": "blank",
              "span": 4
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Questions"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "questionsAsked",
              "formula": "COUNTA({{col:responses.question}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Questions Answered"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "questionsAnswered",
              "formula": "COUNTA({{col:responses.response}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Stakeholders"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "stakeholdersMapped",
              "formula": "COUNTA({{col:stakeholders.name}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Must Say Yes"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "mustSayYesCount",
              "formula": "COUNTIF({{col:stakeholders.mustSayYes}},{{word:booleanYes}})",
              "valueType": "number"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Can Say No"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "canSayNoCount",
              "formula": "COUNTIF({{col:stakeholders.canSayNo}},{{word:booleanYes}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Sentiment Unknown"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "sentimentUnknown",
              "formula": "COUNTIF({{col:stakeholders.sentiment}},\"Unknown\")",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Sentiment Negative"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "sentimentNegative",
              "formula": "COUNTIF({{col:stakeholders.sentiment}},\"Negative\")",
              "valueType": "number"
            },
            {
              "kind": "blank",
              "span": 4
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Milestones"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "milestonesTotal",
              "formula": "COUNTA({{col:milestones.description}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Milestones Complete"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "milestonesComplete",
              "formula": "COUNTIF({{col:milestones.status}},{{word:statusComplete}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Actions Open"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "actionsOpen",
              "formula": "COUNTA({{col:actions.action}})-COUNTIF({{col:actions.status}},{{word:statusComplete}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Actions Overdue"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "actionsOverdue",
              "formula": "SUMPRODUCT(({{col:actions.dueDate}}<>\"\")*({{col:actions.dueDate}}<TODAY())*({{col:actions.status}}<>{{word:statusComplete}}))",
              "valueType": "number"
            }
          ]
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Internal Team"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "teamInternalCount",
              "formula": "COUNTA({{col:teamInternal.name}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Team Assigned"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "teamInternalAssigned",
              "formula": "COUNTIF({{col:teamInternal.assignedToDeal}},{{word:booleanYes}})",
              "valueType": "number"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Partner Team"
            },
            {
              "kind": "computed",
              "span": 2,
              "id": "teamPartnerCount",
              "formula": "COUNTA({{col:teamPartner.name}})",
              "valueType": "number"
            },
            {
              "kind": "blank",
              "span": 4
            }
          ]
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Completion By Section"
        },
        {
          "kind": "table",
          "table": {
            "id": "sections",
            "source": {
              "kind": "sections"
            },
            "anchorColumn": 2,
            "keyColumn": "section",
            "columns": [
              {
                "id": "section",
                "header": "Section",
                "role": "derived",
                "valueType": "string",
                "span": 4,
                "heading": true
              },
              {
                "id": "status",
                "header": "Status",
                "role": "derived",
                "valueType": "string",
                "conditionalFormat": "completionText",
                "span": 2,
                "followsInput": true
              }
            ]
          }
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Salesforce"
        },
        {
          "kind": "row",
          "cells": [
            {
              "kind": "label",
              "span": 2,
              "text": "Opportunity ID"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "salesforceOpportunityId",
              "jsonPath": "metadata.salesforce.opportunityId",
              "valueType": "string"
            },
            {
              "kind": "label",
              "span": 2,
              "text": "Account ID"
            },
            {
              "kind": "field",
              "span": 2,
              "id": "salesforceAccountId",
